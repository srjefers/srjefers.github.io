---
<div class="floating-dock">
  <button id="back-to-top" class="back-to-top" aria-label="Back to top" title="Back to top">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
  </button>
  <div id="font-switch" class="font-switch" role="radiogroup" aria-label="Font style">
    <button class="f-roboto" data-font="roboto" aria-checked="false" role="radio" title="Roboto">Aa</button>
    <button class="f-mono" data-font="mono" aria-checked="false" role="radio" title="Mono (SF Mono / Menlo)">Aa</button>
    <button class="f-times" data-font="times" aria-checked="false" role="radio" title="Times New Roman">Aa</button>
  </div>
</div>
