<dialog id="shortcuts-dialog" class="shortcuts-dialog" aria-label="Keyboard shortcuts">
  <h3>Keyboard shortcuts</h3>
  <ul>
    <li><kbd>T</kbd><span>Cycle theme (light / dark / sepia)</span></li>
    <li><kbd>F</kbd><span>Cycle font (roboto / mono / times)</span></li>
    <li><kbd>G</kbd> + <kbd>T</kbd><span>Back to top</span></li>
    <li><kbd>?</kbd><span>Toggle this dialog</span></li>
    <li><kbd>Esc</kbd><span>Close dialog</span></li>
  </ul>
  <button class="btn ghost" id="shortcuts-close" type="button">Close</button>
</dialog>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
