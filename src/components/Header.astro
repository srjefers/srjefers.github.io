---
const navItems = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#work', label: 'Work' },
  { href: '#skills', label: 'Skills' },
  { href: '#training', label: 'Training' },
];
---
<header class="site-header">
  <a href="#top" class="brand">JA<span class="dot">.</span></a>
  <nav aria-label="Primary">
    {navItems.map(({ href, label }) => <a href={href}>{label}</a>)}
  </nav>
  <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle theme (light / dark / sepia)">
    <svg class="icon sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
    <svg class="icon moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg>
    <svg class="icon book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4.5A2.5 2.5 0 016.5 2H20v15H6.5A2.5 2.5 0 004 19.5V4.5z"/><path d="M4 19.5A2.5 2.5 0 006.5 22H20"/><path d="M8 7h8M8 11h6"/></svg>
  </button>
</header>
